{
  "name": "ez-php/websocket-tls",
  "version": "2.4.7",
  "description": "TLS/WSS termination for ez-php/websocket — an ssl:// listener and Fiber event loop that hands negotiated connections to the plain WebSocket server's Connection/HandlerInterface.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["websocket", "tls", "wss", "ssl", "fiber", "realtime", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/websocket-tls",
  "support": {
    "issues": "https://github.com/ez-php/websocket-tls/issues",
    "source": "https://github.com/ez-php/websocket-tls"
  },
  "require": {
    "php": "^8.5",
    "ext-openssl": "*",
    "ez-php/websocket": "^2.0"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\WebsocketTls\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
